#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 0 && $# -ne 2 ]]; then
  echo "Usage: wtmerge [<branch-to-keep> <commit-message>]" >&2
  exit 1
fi

# wtree flattens slashes in branch names to dashes in the worktree directory
# name, so the branch can't be recovered from the path. Ask git instead.
# Prints nothing when the worktree is in a detached HEAD state.
branch_at() {
  git -C "$1" symbolic-ref --quiet --short HEAD 2>/dev/null || true
}

repo_root="$(git rev-parse --show-toplevel)"
repo_name="$(basename "$repo_root")"
worktree_parent="$(dirname "$repo_root")"

base_branch="main"
if ! git -C "$repo_root" rev-parse --verify "refs/heads/${base_branch}" >/dev/null 2>&1; then
  if git -C "$repo_root" rev-parse --verify refs/heads/master >/dev/null 2>&1; then
    base_branch="master"
  fi
fi

# Plain read loop rather than mapfile: macOS ships bash 3.2, which lacks it
worktrees=()
while IFS= read -r wt_path; do
  [[ -n "$wt_path" ]] && worktrees+=("$wt_path")
done < <(
  git -C "$repo_root" worktree list |
    awk '{print $1}' |
    grep "^${worktree_parent}/${repo_name}-" || true
)

if [[ $# -eq 2 ]]; then
  branch_to_keep="$1"
  commit_message="$2"
  target_worktree="${worktree_parent}/${repo_name}-${branch_to_keep//\//-}"

  if [[ ! -d "$target_worktree" ]]; then
    echo "No active worktree found for ${branch_to_keep}." >&2
    exit 1
  fi

  if ! (
    cd "$target_worktree" &&
      git diff --quiet &&
      git diff --cached --quiet
  ); then
    (
      cd "$target_worktree"
      git add .
      git commit -m "chore: auto-commit changes in ${branch_to_keep} before merge"
    )
  fi

  (
    cd "$repo_root"
    git switch "$base_branch"
    git merge "$branch_to_keep" -m "$commit_message"
  )
fi

for wt in "${worktrees[@]}"; do
  wt_branch="$(branch_at "$wt")"

  git -C "$repo_root" worktree remove "$wt" --force || true

  if [[ -n "$wt_branch" && "$wt_branch" != "$base_branch" ]]; then
    git -C "$repo_root" branch -D "$wt_branch" 2>/dev/null || true
  fi
done
