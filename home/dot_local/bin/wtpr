#!/usr/bin/env bash

set -euo pipefail

no_setup=false
branch=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--no-setup)
      no_setup=true
      shift
      ;;
    -h|--help)
      echo "Usage: wtpr [-n|--no-setup] <remote-branch-name>"
      exit 0
      ;;
    *)
      branch="$1"
      shift
      ;;
  esac
done

if [[ -z "$branch" ]]; then
  echo "Usage: wtpr [-n|--no-setup] <remote-branch-name>" >&2
  exit 1
fi

git fetch origin "$branch"
git branch "$branch" "origin/$branch" 2>/dev/null || true

if [[ "$no_setup" == true ]]; then
  wtree "$branch"
else
  wtree -r "$branch"
fi
