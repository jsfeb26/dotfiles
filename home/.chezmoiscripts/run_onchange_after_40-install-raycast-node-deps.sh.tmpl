#!/usr/bin/env bash

set -euo pipefail

{{- if eq .chezmoi.os "darwin" }}
raycast_node_dir="${HOME}/.config/raycast/nodeScripts"

if [[ ! -d "${raycast_node_dir}" ]]; then
  exit 0
fi

if ! command -v npm >/dev/null 2>&1; then
  exit 0
fi

(
  cd "${raycast_node_dir}"
  if [[ -f package-lock.json ]]; then
    npm ci
  else
    npm install
  fi
)
{{- else }}
exit 0
{{- end }}
